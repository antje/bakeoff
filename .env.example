# Copy to .env and fill in. Never commit .env.

# OpenRouter. One key, every model, every provider. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: direct Anthropic access for the skills' own model calls.
ANTHROPIC_API_KEY=

# Optional: an OpenAI-compatible endpoint you run yourself (vLLM, SGLang).
# When set, the harness can bench it alongside OpenRouter providers.
LOCAL_BASE_URL=
LOCAL_API_KEY=

# Spend guard. The harness refuses to start a run whose estimated cost exceeds this.
BAKEOFF_MAX_RUN_USD=5
